@page "/counter"
@using Mafesoft.Localization.Blazor.Bindings

<h1><Translate Key="BlazorCounter" Default="Counter" /></h1>

<p><Translate Key="BlazorCurrentCount" Default="Current count" />: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount"><Translate Key="BlazorClickMe" Default="Click me" /></button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}

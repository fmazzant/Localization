{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Localization": {
    // "Extensions": AddLocalizationManager(...).AddStringLocalizer() - IStringLocalizer reads the vocabularies
    // "Mvc": AddMvcLocalizationManager(...) - IStringLocalizer is the standard resx one
    "Registration": "Extensions",
    "Culture": "it-IT",
    "SupportedCultures": [ "it-IT", "en-US" ],
    // true: every request has its own culture (cookie, ?culture=, Accept-Language)
    "FollowCurrentUICulture": false,
    // true: IStringLocalizer<HomeController>["Key"] reads "HomeController.Key" (only with "Extensions")
    "UseTypeNamePrefix": false
  }
}

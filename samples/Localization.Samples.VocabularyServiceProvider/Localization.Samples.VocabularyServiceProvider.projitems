<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>e0d66fd1-b3ea-41f2-af2f-0582b1049eef</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Localization.Samples.VocabularyServiceProvider</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MockVocabularyServiceProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SampleVocabularies.cs" />
  </ItemGroup>
  <!-- JSON vocabularies (Mafesoft.Localization.Json), embedded as Resources.it-IT.json and Resources.en-US.json -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Resources\*.json" LogicalName="Resources.%(Filename)%(Extension)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Localization.Json\Localization.Json.csproj" />
  </ItemGroup>
</Project>
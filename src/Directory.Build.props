<Project>

  <!-- Shared build settings for every project under src/ (NuGet metadata lives in each .csproj) -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsPackable Condition="'$(IsTestProject)' == 'true'">false</IsPackable>
  </PropertyGroup>

  <!--
    Single version source for every package. The publish workflow checks that the release tag (v4.1.0) matches it.
    A prerelease is published with a suffix: dotnet pack -p:VersionSuffix=beta.1
  -->
  <PropertyGroup>
    <VersionPrefix>4.4.0</VersionPrefix>
  </PropertyGroup>

  <!-- Package validation: the baseline version is computed in Directory.Build.targets -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!--
    Trimming and NativeAOT (issue #32): the .NET 10 builds of the libraries are marked trimmable and AOT compatible, so
    the trimming / AOT analyzers run on every build and the apps that trim do not get warnings from the Mafesoft
    assemblies. A library that cannot be (Localization.Json.Newtonsoft) sets both to false in its .csproj.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and $(TargetFramework.StartsWith('net10.0'))">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Libraries: nullable reference types, every nullable warning is an error -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>

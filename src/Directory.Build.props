<Project>

  <!-- Shared build settings for every project under src/ (NuGet metadata lives in each .csproj) -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsPackable Condition="'$(IsTestProject)' == 'true'">false</IsPackable>
  </PropertyGroup>

  <!--
    Single version source for every package. The publish workflow checks that the release tag (v4.1.0) matches it.
    A prerelease is published with a suffix: dotnet pack -p:VersionSuffix=beta.1
  -->
  <PropertyGroup>
    <VersionPrefix>4.1.1.1</VersionPrefix>
  </PropertyGroup>

  <!-- Package validation: the baseline version is computed in Directory.Build.targets -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Libraries: nullable reference types, every nullable warning is an error -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>

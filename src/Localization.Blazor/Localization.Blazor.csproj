<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Mafe.Localization.Blazor</PackageId>
    <Description>A Blazor library for .net that can help you to manage the localization in your application. The library uses Mafe.Localization</Description>
    <PackageTags>localization;i18n;c-sharp;dotnet-core;blazor</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization\Localization.csproj" />
  </ItemGroup>

</Project>

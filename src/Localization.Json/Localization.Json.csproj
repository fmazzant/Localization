<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <PackageId>Mafesoft.Localization.Json</PackageId>
    <!-- First published in 4.4.0: package validation baseline from that version on (see Directory.Build.targets) -->
    <PackageFirstVersion>4.4.0</PackageFirstVersion>
    <Authors>Federico Mazzanti</Authors>
    <Company>Federico Mazzanti</Company>
    <Copyright>Copyright (c) 2026 Federico Mazzanti</Copyright>
    <Description>JSON vocabularies for Mafesoft.Localization: one file per culture (flat or nested keys) from embedded resources, a directory or an IFileProvider, with reload on change and the missing keys written to a file.</Description>
    <PackageTags>localization;i18n;json;c-sharp;dotnet-standard;dotnet-core;dotnet-framework</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/fmazzant/Localization/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/fmazzant/Localization</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fmazzant/Localization</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    System.Text.Json is part of .NET 8 and .NET 10; .NET Standard 2.0 and .NET Framework get the package.
    The file providers: IFileProvider and the directory source with its file watcher.
    Minimum version for each .NET version (src/Directory.Packages.props): the application can use any newer one.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization\Localization.csproj" />
  </ItemGroup>

  <!--
    The source generator of the keys and the MLOC001 analyzer (Localization.Json.Generator, issue #31) are shipped in
    this package as an analyzer, with the props that make its MSBuild properties visible to the compiler.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Localization.Json.Generator\Localization.Json.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Localization.Json.Generator\bin\$(Configuration)\netstandard2.0\Mafesoft.Localization.Json.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\Mafesoft.Localization.Json.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Localization.Tests" />
  </ItemGroup>

</Project>

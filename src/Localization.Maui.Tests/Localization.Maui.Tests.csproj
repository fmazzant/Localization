<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The MAUI controls without a platform head: the tests run on Linux, macOS and Windows -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mafesoft.Localization.Maui.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- Same test vocabulary as Localization.Tests (it also disables the parallel tests: LocalizationManager is a singleton) -->
  <ItemGroup>
    <Compile Include="..\Localization.Tests\TestVocabularyServiceProvider.cs" Link="TestVocabularyServiceProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization.Maui\Localization.Maui.csproj" />
  </ItemGroup>

</Project>

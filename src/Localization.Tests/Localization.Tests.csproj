<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!--
      .NET Framework runs only on Windows: there the net462 build of the core library is tested too. The test project
      targets net472 (the minimum of xunit.runner.visualstudio 3.x), which picks the net462 assembly of Localization.
    -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net472</TargetFrameworks>
    <RootNamespace>Mafesoft.Localization.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- In-memory ASP.NET Core server for the per-request culture integration tests -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization\Localization.csproj" />
  </ItemGroup>

  <!-- Blazor, MVC, ASP.NET Core and NullabilityInfoContext do not exist on .NET Framework -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ProjectReference Include="..\Localization.Blazor\Localization.Blazor.csproj" />
    <ProjectReference Include="..\Localization.Mvc\Localization.Mvc.csproj" />
    <ProjectReference Include="..\Localization.Extensions\Localization.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Compile Remove="AsyncInitializationTests.cs;BlazorBindingTests.cs;MvcTests.cs;NullabilityTests.cs;PerRequestCultureTests.cs;StringLocalizerTests.cs" />
  </ItemGroup>

</Project>

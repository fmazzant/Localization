<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PackageId>Mafe.Localization.Windows</PackageId>
    <Description>A Window WPF library for .net that can help you to manage the localization in your application. The library uses Mafe.Localization</Description>
    <PackageTags>localization;i18n;c-sharp;dotnet-core;windows;wpf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization\Localization.csproj" />
  </ItemGroup>

</Project>
